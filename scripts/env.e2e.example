# Copy to scripts/env.e2e.local (gitignored) or export before running E2E validation.
# Lab example — replace with your SOAR host before GitHub release sign-off.

SOAR_URL=https://your-soar.example.com:8443
SOAR_USER=soar_local_admin
SOAR_PASSWORD=change-me
SOAR_VERIFY_SSL=false

# Playbook Builder asset name in SOAR
PB_ASSET=mcpbridge

# Mode: auto | A | B  (A = templates only, B = require MCP bridge)
E2E_MODE=auto

# Mode B — MCP agent bridge base URL (include /agent suffix)
MCP_BRIDGE_URL=http://127.0.0.1:8003/agent
