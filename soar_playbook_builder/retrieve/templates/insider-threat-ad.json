    {"id": "complete", "type": "end", "outcome": "success"},
    {"id": "cancelled", "type": "end", "outcome": "neutral"},
    {"id": "timed_out", "type": "end", "outcome": "neutral"},
    {"id": "failed", "type": "end", "outcome": "failure"}
  ],
