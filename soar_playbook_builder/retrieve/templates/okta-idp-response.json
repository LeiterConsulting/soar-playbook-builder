{
  "schema_version": "1.0.0",
  "id": "okta-idp-response",
  "name": "Okta IDP Response",
  "description": "Require analyst approval before disabling a high-risk Okta user.",
  "entrypoint": "start",
  "nodes": [
    {"id": "start", "type": "start", "next": "approval"},
    {"id": "approval", "type": "prompt", "message": "Approve disabling the high-risk Okta user?", "response_key": "approval", "choices": ["Approve", "Reject"], "on_success": "disable_user", "on_failure": "cancelled", "on_timeout": "timed_out"},
    {"id": "disable_user", "type": "action", "app": "okta", "action": "disable user", "asset": {"kind": "asset_unbound"}, "parameters": {"username": {"kind": "datapath", "scope": "artifact", "path": ["cef", "destinationUserName"]}}, "on_success": "complete", "on_failure": "failed"},
    {"id": "complete", "type": "end", "outcome": "success"},
    {"id": "cancelled", "type": "end", "outcome": "neutral"},
    {"id": "timed_out", "type": "end", "outcome": "neutral"},
    {"id": "failed", "type": "end", "outcome": "failure"}
  ],
  "metadata": {"capability_index_version": "template-library-v1", "operating_mode": "restricted", "template_id": "okta-idp-response", "labels": ["okta", "identity", "response"]}
}
