{
  "schema_version": "1.0.0",
  "id": "clearpass-quarantine",
  "name": "Aruba ClearPass Quarantine",
  "description": "Require analyst approval before quarantining a device through ClearPass.",
  "entrypoint": "start",
  "nodes": [
    {"id": "start", "type": "start", "next": "approval"},
    {"id": "approval", "type": "prompt", "message": "Approve quarantining this endpoint?", "response_key": "approval", "choices": ["Approve", "Reject"], "on_success": "quarantine_device", "on_failure": "cancelled", "on_timeout": "timed_out"},
    {"id": "quarantine_device", "type": "action", "app": "clearpass_cppm", "action": "quarantine device", "asset": {"kind": "asset_unbound"}, "parameters": {"endpoint": {"kind": "datapath", "scope": "artifact", "path": ["cef", "sourceAddress"]}}, "on_success": "complete", "on_failure": "failed"},
    {"id": "complete", "type": "end", "outcome": "success"},
    {"id": "cancelled", "type": "end", "outcome": "neutral"},
    {"id": "timed_out", "type": "end", "outcome": "neutral"},
    {"id": "failed", "type": "end", "outcome": "failure"}
  ],
  "metadata": {"capability_index_version": "template-library-v1", "operating_mode": "restricted", "template_id": "clearpass-quarantine", "labels": ["clearpass", "nac", "quarantine"]}
}
