# Copy to .env.local for Vite dev against a live SOAR instance:
#
#   cp .env.example .env.local
#
# Mock mode (no SOAR required — default when .env.local is absent):
#   npm run dev  → opens http://localhost:5173 with mock API
#
# Live SOAR via dev proxy:
#   Set VITE_SOAR_HANDLER_BASE (and optional VITE_SOAR_URL / credentials)
#
# Force mocks even with handler base:
# VITE_USE_MOCKS=true
#
# Mock dev: bridge reachable but LLM not configured unless:
# VITE_MOCK_LLM=true

VITE_SOAR_URL=https://10.236.39.108:8443
VITE_SOAR_HANDLER_BASE=/rest/handler/soarplaybookbuilder_<uuid>/mcpbridge
VITE_SOAR_USER=soar_local_admin
VITE_SOAR_PASS=password
